[run]
source = .
omit =
    test_*.py
    .venv/*
# python-coverage-comment-action lee este archivo desde otro checkout, así que
# las rutas absolutas del runner no le sirven.
relative_files = true

[report]
show_missing = True
fail_under = 90
exclude_lines =
    pragma: no cover
    if __name__ == '__main__':
